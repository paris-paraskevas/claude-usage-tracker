<?xml version="1.0" encoding="utf-8"?>
<!-- Widget background below Android 12, where Glance's cornerRadius is ignored: a white rounded
     rect tinted at runtime with the theme's widget background (or the limit-reached surface). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#FFFFFFFF" />
    <corners android:radius="16dp" />
</shape>
