<?xml version="1.0" encoding="utf-8"?>
<!-- Usage bar in the on-pace colour (static picker preview, layout/widget_preview.xml). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="3dp" />
            <solid android:color="@color/widget_preview_track" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="3dp" />
                <solid android:color="@color/widget_preview_ok" />
            </shape>
        </clip>
    </item>
</layer-list>
